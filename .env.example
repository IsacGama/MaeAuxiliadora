
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DEVOTION_AUDIO_BASE_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:8080

# API de liturgia diária
EXPO_PUBLIC_LITURGY_API_URL=https://liturgia.up.railway.app/v2

# API de santo do dia
EXPO_PUBLIC_SAINT_API_URL=https://catolicoapp.com/wp-json/wp/v2/santos

# Domínio configurado no painel para identificar a unidade (capela/paróquia/diocese)
EXPO_PUBLIC_ORG_DOMAIN=localhost

# Timeout de requisição (ms)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=10000

# Hosts HTTPS que devem abrir o app via Universal Links / Android App Links.
# Exemplo: EXPO_PUBLIC_APP_LINK_HOSTS=paroquia.isacgama.tech,eclesialhub.isacgama.tech
EXPO_PUBLIC_APP_LINK_HOSTS=
