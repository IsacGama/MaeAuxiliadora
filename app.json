{
  "expo": {
    "name": "Paroquia Digital",
    "slug": "paroquia-digital",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-generic.png",
    "scheme": "paroquiadigital",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-generic.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E293B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paroquiadigital.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-generic.png",
        "backgroundColor": "#1E293B"
      },
      "package": "com.paroquiadigital.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-generic.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1b44150f-adf7-49e7-8582-749b7de3ef49"
      }
    }
  }
}
